NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional but recommended: create portal logins without sending Auth emails (avoids rate limits).
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — enables live OpenAI summaries for AI Work Summary.
# Without this key, a local professional fallback summarizer is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
